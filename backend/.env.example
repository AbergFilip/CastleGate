# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
API_VERSION=1.0.0

# Database (Supabase Postgres)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT / Auth
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_PEPPER=your-refresh-token-pepper
FIELD_ENCRYPTION_KEY=your-32-byte-hex-key
FIELD_HASH_PEPPER=your-hash-pepper

# BankID
BANKID_PRODUCTION=false

# Test: POST /api/v1/test-data/clear-all rensar all användardata (ej profil/inloggning)
# ENABLE_TEST_DATA_TOOLS=true

# Tink (Open Banking)
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=

# GoCardless (Open Banking)
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Lantmateriet
LANTMATERIET_CONSUMER_KEY=
LANTMATERIET_CONSUMER_SECRET=
LANTMATERIET_USE_VERIFICATION=false

# OIDC / Auth0 (optional)
OIDC_ENABLED=false
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_JWKS_URI=

# Azure Key Vault (optional)
KEY_VAULT_ENABLED=false
AZURE_KEY_VAULT_URL=

# mTLS (optional)
MTLS_ENABLED=false
MTLS_KEY_PATH=
MTLS_CERT_PATH=
MTLS_CA_PATH=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# CastleGate – Backend miljövariabler
# -----------------------------------------------------------------------------
# Kopiera till backend/.env för lokal utveckling.
# I Vercel: lägg in i Project Settings → Environment Variables för backend-projektet.
# -----------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Kommaseparerad lista av tillåtna origins (för CORS). I Vercel: sätt till din
# frontend-URL, t.ex. https://castlegate.vercel.app,https://staging.castlegate.se
FRONTEND_URL=http://localhost:5173
API_VERSION=1.0.0

# --- Database (Supabase Postgres) -------------------------------------------
# VIKTIGT på Vercel: använd Supabase "Session pooler" (host innehåller
# ".pooler.supabase.com"), INTE Direct connection (host "db.<ref>.supabase.co").
#
# Varför Session pooler (och inte Transaction pooler)?
# TypeORM använder prepared statements som Transaction pooler (PgBouncer i
# transaction-mode) inte stöder → du får "prepared statement already exists".
# Session pooler beter sig som direkt anslutning och funkar med TypeORM rakt av.
#
# Hämta URL:en: Supabase Dashboard → Settings → Database → välj "Session pooler"
# och kopiera Shared pooler-URI:n. Formen är:
#   postgresql://postgres.<projekt-ref>:<lösenord>@aws-X-<region>.pooler.supabase.com:5432/postgres
# OBS: användarnamnet är "postgres.<ref>" (med punkt), inte bara "postgres".
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Supabase (auth) --------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- JWT / Auth -------------------------------------------------------------
# Generera säkra värden med: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me-generate-a-random-secret
REFRESH_TOKEN_PEPPER=change-me-generate-a-random-secret
FIELD_ENCRYPTION_KEY=change-me-32-byte-hex-string
FIELD_HASH_PEPPER=change-me-random

# --- BankID -----------------------------------------------------------------
# false = BankID Test (fungerar med test-personnummer och test-certifikat)
# true = BankID Production (kräver riktigt certifikat + verifierad domän)
BANKID_PRODUCTION=false

# --- Test-verktyg -----------------------------------------------------------
# POST /api/v1/test-data/clear-all rensar användarens synkade data. Sätt aldrig i produktion.
# ENABLE_TEST_DATA_TOOLS=true

# --- Open Banking (valfritt) ------------------------------------------------
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# --- Lantmäteriet (valfritt) ------------------------------------------------
LANTMATERIET_CONSUMER_KEY=
LANTMATERIET_CONSUMER_SECRET=
LANTMATERIET_USE_VERIFICATION=true

# --- OIDC / Auth0 (valfritt) ------------------------------------------------
OIDC_ENABLED=false
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_JWKS_URI=

# --- Azure Key Vault (valfritt) ---------------------------------------------
KEY_VAULT_ENABLED=false
AZURE_KEY_VAULT_URL=

# --- mTLS (fungerar EJ på Vercel serverless) --------------------------------
# Lämna som false när du kör på Vercel. Vercel terminerar TLS själv.
MTLS_ENABLED=false
MTLS_KEY_PATH=
MTLS_CERT_PATH=
MTLS_CA_PATH=

# --- Rate limiting ----------------------------------------------------------
# OBS: nuvarande implementation är in-memory och nollställs per lambda-instans
# på Vercel. Räcker för test/demo – flytta till Redis/Upstash för produktion.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

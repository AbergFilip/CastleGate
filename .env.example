# Supabase (session-hantering via BankID-inloggning)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_BANKID_API_URL=http://localhost:3001/api/v1/bankid

# Set to true to skip BankID QR in dev (sandbox "hämta"-flöden går direkt vidare)
# VITE_SKIP_BANKID=true

# Visa "Rensa all min testdata" på Profil (kräver ENABLE_TEST_DATA_TOOLS=true i backend)
# VITE_ENABLE_TEST_DATA_TOOLS=true

# Session
VITE_SESSION_TIMEOUT_MINUTES=15

# Demo
# VITE_DEMO_MODE=true   # Visar "DEMO"-badge i UI:t

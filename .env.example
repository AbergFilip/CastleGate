# -----------------------------------------------------------------------------
# CastleGate – Frontend miljövariabler
# -----------------------------------------------------------------------------
# Kopiera denna fil till `.env` för lokal utveckling.
# I Vercel: lägg in samma nycklar under Project Settings → Environment Variables.
# -----------------------------------------------------------------------------

# --- Supabase (session-hantering via BankID-inloggning) ----------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Backend API -------------------------------------------------------------
# Lokal utveckling:
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_BANKID_API_URL=http://localhost:3001/api/v1/bankid
#
# Produktion (exempel – byt till din faktiska backend-URL):
# VITE_API_BASE_URL=https://api.castlegate.se/api/v1
# VITE_BANKID_API_URL=https://api.castlegate.se/api/v1/bankid

# --- Sessions ----------------------------------------------------------------
VITE_SESSION_TIMEOUT_MINUTES=15

# --- Dev / test-flaggor (sätt ALDRIG i produktion) ---------------------------
# Skippa BankID QR i dev och gå direkt vidare i sandbox-flöden
# VITE_SKIP_BANKID=true
#
# Visa "Rensa all min testdata" på Profil (kräver ENABLE_TEST_DATA_TOOLS=true i backend)
# VITE_ENABLE_TEST_DATA_TOOLS=true
#
# Visar "DEMO"-badge i UI:t
# VITE_DEMO_MODE=true

# --- Valfria integrationer ---------------------------------------------------
# Auth0 (aktiveras när BÅDE domain och client_id är satta)
# VITE_AUTH0_DOMAIN=din-tenant.us.auth0.com
# VITE_AUTH0_CLIENT_ID=din-client-id
# VITE_AUTH0_AUDIENCE=

# Tink Link (client_id från https://console.tink.com)
# VITE_TINK_CLIENT_ID=din-tink-client-id
